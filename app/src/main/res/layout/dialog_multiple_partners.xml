<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- First Partner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="First Partner's Name (Mandatory)"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/input_partner1_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter first partner's name"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="First Partner's DOB (MM/DD/YYYY)"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/input_partner1_dob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter first partner's DOB"
            android:inputType="date" />

        <!-- Second Partner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Second Partner's Name (Optional)"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/input_partner2_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter second partner's name"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Second Partner's DOB (Optional)"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/input_partner2_dob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter second partner's DOB"
            android:inputType="date" />

        <!-- Third Partner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Third Partner's Name (Optional)"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/input_partner3_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter third partner's name"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Third Partner's DOB (Optional)"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/input_partner3_dob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter third partner's DOB"
            android:inputType="date" />
    </LinearLayout>
</ScrollView>

